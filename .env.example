# Docker Compose reads this file from the repository root. Do not commit .env.
PI_MODEL=glm/GLM-5.2
PI_BASE_URL=https://your-provider.example/v1
PI_API_KEY=

# Leave this as the named Docker volume for an empty/read-only demo. To expose
# canonical data collected on a supported macOS host, set an absolute host path.
CRE_DATA_VOLUME=cre-data
