{
  "name": "agent-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node --env-file=.env --experimental-strip-types src/server.ts",
    "serve": "node --experimental-strip-types src/server.ts",
    "postinstall": "node scripts/resolve-pi-brace-expansion.mjs",
    "test": "node --experimental-strip-types --test test/*.test.ts test/fixtures/*.test.ts",
    "test:browser": "playwright test",
    "test:glm": "RUN_REAL_MODEL_SMOKE=1 node --env-file=.env --experimental-strip-types --test-concurrency=1 --test test/real-model-e2e.test.ts test/real-pld-ui-e2e.test.ts",
    "test:glm:only": "RUN_REAL_MODEL_SMOKE=1 node --env-file=.env --experimental-strip-types --test-concurrency=1",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-ai": "0.83.0",
    "typebox": "1.3.7",
    "ajv": "8.20.0",
    "brace-expansion": "5.0.9"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.20.0",
    "@playwright/test": "^1.62.1",
    "@axe-core/playwright": "^4.12.1"
  }
}
